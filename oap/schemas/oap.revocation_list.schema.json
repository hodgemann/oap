{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oap:revocation_list:0.5",
  "type": "object",
  "properties": {
    "oap_revocation_list_version": {
      "type": "string",
      "pattern": "^0\\.5\\.[0-9]+$"
    },
    "list_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_update": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "signer": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1
        }
      },
      "required": [
        "key_id",
        "public_key"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    }
  },
  "required": [
    "oap_revocation_list_version",
    "list_id",
    "issued_at",
    "next_update",
    "signer",
    "entries",
    "signature"
  ],
  "additionalProperties": false
}
