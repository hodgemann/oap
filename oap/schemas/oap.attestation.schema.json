{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oap:attestation:0.5",
  "type": "object",
  "properties": {
    "oap_attestation_version": {
      "type": "string",
      "pattern": "^0\\.5\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "issuer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "key_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1
        }
      },
      "required": [
        "key_id",
        "public_key"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "package_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_key_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor_id"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "minProperties": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    }
  },
  "required": [
    "oap_attestation_version",
    "id",
    "issued_at",
    "expires_at",
    "issuer",
    "subject",
    "claims",
    "signature"
  ],
  "additionalProperties": false
}
